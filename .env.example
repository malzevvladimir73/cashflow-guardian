# Local environment template only. Never put real credentials in this file.
# PayPal Sandbox values are used by START_SANDBOX.bat; they are never sent to AI.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Optional external-AI experiment. The bridge sends only synthetic demo records
# and rejects invoice row payloads. Review the provider privacy terms first.
OPENAI_API_KEY=
OPENAI_MODEL=
